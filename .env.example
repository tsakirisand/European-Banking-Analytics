# Database Configuration
DB_TYPE=sqlite # sqlite or postgresql
DB_PATH=european_banking_star.db

# PostgreSQL Credentials (if DB_TYPE=postgresql)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=european_banking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# API Settings
ECB_API_BASE_URL=https://data-api.ecb.europa.eu/service/data
EUROSTAT_API_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/statistics/1.0/data
INGESTION_START_YEAR=2000
